<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="qupath.ext.tiatoolbox.ui.TrainingController"
      spacing="10.0" prefWidth="620.0" prefHeight="560.0">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <GridPane hgap="8.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints minWidth="150.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
            <RowConstraints/>
        </rowConstraints>

        <Label text="%training.project" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="projectLabel" wrapText="true"
               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button fx:id="refreshButton" text="%training.refresh" onAction="#onRefresh"
                GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="%training.task" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="taskChoice" maxWidth="Infinity"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="%training.backbone" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="backboneChoice" maxWidth="Infinity"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="%training.run-name" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="runNameField" promptText="%training.run-name.prompt"
                   GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"
                   GridPane.hgrow="ALWAYS"/>

        <Label text="%ui.device" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="deviceChoice" maxWidth="Infinity"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="%training.epochs" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Spinner fx:id="epochsSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="%ui.batch-size" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Spinner fx:id="batchSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="%training.learning-rate" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="learningRateField" prefWidth="110.0"
                   GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <GridPane hgap="8.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints minWidth="150.0"/>
            <ColumnConstraints/>
            <ColumnConstraints minWidth="120.0"/>
            <ColumnConstraints/>
        </columnConstraints>

        <Label text="%training.patch-size" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Spinner fx:id="patchSizeSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%training.stride" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Spinner fx:id="strideSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="%training.validation" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="validationSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="%training.max-patches" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <Spinner fx:id="maxPatchesSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="%training.seed" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Spinner fx:id="seedSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="%training.mpp" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <Spinner fx:id="mppSpinner" editable="true" prefWidth="110.0"
                 GridPane.rowIndex="2" GridPane.columnIndex="3"/>
    </GridPane>

    <Label text="%training.classes"/>
    <ScrollPane fitToWidth="true" prefViewportHeight="130.0" VBox.vgrow="ALWAYS">
        <VBox fx:id="classBox" spacing="4.0">
            <padding><Insets top="6" right="6" bottom="6" left="6"/></padding>
        </VBox>
    </ScrollPane>

    <VBox spacing="4.0">
        <Label fx:id="statusLabel" text="%training.status.idle" wrapText="true"/>
        <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0"/>
    </VBox>

    <HBox spacing="8.0" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="trainButton" text="%training.run" onAction="#onTrain" defaultButton="true"/>
        <Button fx:id="cancelButton" text="%ui.cancel" onAction="#onCancel" disable="true"/>
    </HBox>
</VBox>
