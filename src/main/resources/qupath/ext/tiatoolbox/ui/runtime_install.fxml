<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="qupath.ext.tiatoolbox.ui.RuntimeInstallController"
      spacing="10.0" prefWidth="560.0" prefHeight="380.0">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <Label text="%runtime.install.intro" wrapText="true"/>

    <GridPane hgap="8.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints minWidth="140.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints/>
        </rowConstraints>

        <Label text="%runtime.install.path" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="pathLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
               wrapText="true"/>
    </GridPane>

    <VBox fx:id="statusBox" spacing="4.0">
        <Label fx:id="statusLabel" text="%runtime.install.status.idle" wrapText="true"/>
        <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0"/>
    </VBox>

    <TitledPane fx:id="logPane" text="%runtime.install.show-log" expanded="false"
                animated="false" VBox.vgrow="ALWAYS">
        <TextArea fx:id="logArea" editable="false" wrapText="false"
                  prefRowCount="10" style="-fx-font-family: 'monospace';"/>
    </TitledPane>

    <HBox spacing="8.0" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="installButton" text="%runtime.install.button.install"
                onAction="#onInstall" defaultButton="true"/>
        <Button fx:id="closeButton" text="%runtime.install.button.close"
                onAction="#onClose"/>
    </HBox>
</VBox>
