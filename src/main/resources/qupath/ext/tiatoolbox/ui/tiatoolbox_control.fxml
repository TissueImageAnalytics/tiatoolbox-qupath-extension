<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="qupath.ext.tiatoolbox.ui.TIAController"
      spacing="10.0" prefWidth="480.0">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <!-- Title row: small logo inline before the extension name. -->
    <HBox spacing="6.0" alignment="CENTER_LEFT">
        <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true">
            <image><Image url="@logo.png"/></image>
        </ImageView>
        <Label text="%title" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>

    <HBox fx:id="runtimeMissingBox" spacing="8.0" alignment="CENTER_LEFT"
          visible="false" managed="false"
          style="-fx-background-color: #fff7e0; -fx-border-color: #d68a00; -fx-border-radius: 4; -fx-background-radius: 4;">
        <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
        <Label text="%runtime.missing.message" wrapText="true" HBox.hgrow="ALWAYS"
               style="-fx-text-fill: #3f2a00;"/>
        <Button text="%runtime.missing.button" onAction="#onOpenInstaller"
                style="-fx-background-color: #8a5a00; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <!--
        Model row. The ComboBox is editable and filterable
        (see TIAController.installModelFilter). A funnel-style glyph sits
        on top of the editor via a StackPane so the field reads as a
        search box at rest. The 'i' button shows the model's full description.
    -->
    <HBox spacing="6.0" alignment="CENTER_LEFT">
        <Label text="%ui.model" minWidth="60.0"/>
        <StackPane HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <ComboBox fx:id="modelChoice" editable="true" maxWidth="Infinity"
                      promptText="%ui.model.filter-prompt">
                <tooltip><Tooltip text="%ui.model.filter-tip"/></tooltip>
            </ComboBox>
            <Label fx:id="modelFilterIcon" text="&#x2315;"
                   mouseTransparent="true"
                   style="-fx-text-fill: #8a8a8a; -fx-font-size: 13px;
                          -fx-padding: 0 0 0 8;"/>
            <Button fx:id="modelClearButton" text="&#x2715;" onAction="#onClearModelFilter"
                    focusTraversable="false"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #6a6a6a;
                           -fx-font-size: 11px;
                           -fx-padding: 0 4 0 4;
                           -fx-cursor: hand;"
                    StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin>
                    <Insets right="30.0"/>
                </StackPane.margin>
                <tooltip><Tooltip text="%ui.model.clear-tip"/></tooltip>
            </Button>
        </StackPane>
        <Button fx:id="modelInfoButton" text="i" onAction="#onShowModelInfo"
                style="-fx-font-size: 12px; -fx-font-style: italic;
                       -fx-min-width: 24px; -fx-pref-width: 24px;">
            <tooltip><Tooltip text="%ui.model.info-tip"/></tooltip>
        </Button>
    </HBox>

    <Label fx:id="modelDescription" wrapText="true" minHeight="36.0"/>

    <GridPane hgap="8.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="80.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints/><RowConstraints/><RowConstraints/>
        </rowConstraints>

        <HBox spacing="8.0" alignment="CENTER_LEFT"
              GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="3">
            <CheckBox fx:id="artifactCheckBox" text="%ui.artifact.use"
                      wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="trainModelButton" text="%ui.artifact.train"
                    onAction="#onTrainModel"/>
        </HBox>
        <TextField fx:id="artifactField" editable="false"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"
                   GridPane.hgrow="ALWAYS"/>
        <Button fx:id="artifactBrowseButton" text="%ui.artifact.browse"
                onAction="#onBrowseArtifact"
                GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <CheckBox fx:id="autoMaskCheckBox" text="%ui.auto-mask"
                  selected="true"
                  GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
    </GridPane>

    <!-- Run-on scope. -->
    <HBox spacing="12.0" alignment="CENTER_LEFT">
        <Label text="%ui.scope"/>
        <fx:define><ToggleGroup fx:id="scopeGroup"/></fx:define>
        <RadioButton fx:id="scopeCurrent" text="%ui.scope.current"
                     selected="true" toggleGroup="$scopeGroup"/>
        <RadioButton fx:id="scopeProject" text="%ui.scope.project"
                     toggleGroup="$scopeGroup"/>
    </HBox>

    <!-- Device + Batch size, inline (no Additional Options pane). -->
    <GridPane hgap="8.0" vgap="6.0">
        <columnConstraints>
            <ColumnConstraints minWidth="60.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints minWidth="80.0"/>
        </columnConstraints>
        <rowConstraints><RowConstraints/></rowConstraints>

        <Label text="%ui.device" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="deviceChoice" maxWidth="Infinity"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="%ui.batch-size" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <Spinner fx:id="batchSpinner" editable="true" prefWidth="80.0"
                 GridPane.rowIndex="0" GridPane.columnIndex="3">
            <tooltip><Tooltip text="%ui.batch-size"/></tooltip>
        </Spinner>
    </GridPane>

    <VBox spacing="4.0">
        <Label fx:id="statusLabel" text="%ui.status.idle"/>
        <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0"/>
    </VBox>

    <HBox spacing="8.0" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="runButton" text="%ui.run" onAction="#onRun" defaultButton="true"/>
        <Button fx:id="cancelButton" text="%ui.cancel" onAction="#onCancel" disable="true"/>
    </HBox>
</VBox>
